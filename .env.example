# DigiDocs settings. Copy to .env.local (development) or set as environment variables
# (production). Read and validated only by src/lib/config.ts; the server refuses to start
# with a list of problems if something is missing or malformed.

# --- Database (SQL Server) ----------------------------------------------------------------
# ADO.NET-style connection string. Use host,port — SQL Server Express uses a dynamic port by
# default, so either set a fixed TCP port in SQL Server Configuration Manager or start the
# "SQL Server Browser" service and use Server=localhost\SQLEXPRESS.
# TrustServerCertificate=true only for local development with a self-signed certificate.
# The database is DigiDocsOPNext. Use a login with data read/write only (database/README.md).
DATABASE_CONNECTION_STRING="Server=localhost,1433;Database=DigiDocsOPNext;User Id=digidocs_app;Password=<the login's password>;Encrypt=true;TrustServerCertificate=true"

# Only for `npm run db:migrate`: an account that may create and change tables (the app's own
# login has no DDL rights). Unset, db:migrate uses DATABASE_CONNECTION_STRING — fine on a
# development machine where that is already an owner account.
# MIGRATION_DATABASE_CONNECTION_STRING="Server=localhost,1433;Database=DigiDocsOPNext;User Id=<an owner login>;Password=<its password>;Encrypt=true;TrustServerCertificate=true"

# --- This application ---------------------------------------------------------------------
# Port DigiDocs listens on, for `npm run dev`, `npm run start` and F5 in VS Code. Next.js reads
# the port before it loads this file, so package.json passes it in with dotenv-cli and
# .vscode/launch.json with envFile. To change it, change PORT and APP_URL together (the app
# refuses to start when a localhost APP_URL names another port), then update the callback URL
# registered in OnePortal.
PORT=3008

# Public address of DigiDocs, as people type it. The Secure-cookie switch (https:// => Secure
# cookies). Must be https:// in production.
APP_URL="http://localhost:3008"
APP_NAME="DigiDocs"
ORGANIZATION_NAME="EdgeAxis"

# How long a sign-in lasts, in hours (1–720). The suite uses 8–12 for applications.
SESSION_TTL_HOURS=8

# Which addresses count as test users: the seeds and `data:clear --clear test-users` create,
# change or delete only accounts at these domains. Default: oneportal.test (never a real mailbox).
# The suite's test team uses edgeaxis.in addresses, so a test installation that seeds it lists
# both. Then EVERY @edgeaxis.in account on this database counts as a test user. Never set it
# where real people sign in. The hub and every suite application on the same installation list the same.
# TEST_USER_EMAIL_DOMAINS="oneportal.test,edgeaxis.in"

# Test installations only: lets `npm run db:seed` load the test team (database/seed/test-users.json)
# and sample imports (database/seed/sample-data.json) into THIS database. Without it the command
# refuses to run. The server warns in its log at every start while it is true. Never set it where
# real people sign in.
# ALLOW_SAMPLE_DATA=true

# Test installations only: lets `npm run data:clear` delete chosen parts of THIS database (sample
# data, imports and exports, test users, people, sessions, the audit log). The command still
# deletes nothing until it is given --confirm <database name>. The server warns in its log at
# every start while it is true. Never set it where real people sign in.
# ALLOW_DATA_CLEAR=true

# --- Sign-in through OnePortal ------------------------------------------------------------
# The hub's address as browsers reach it (no trailing slash needed).
ONEPORTAL_URL="http://localhost:3000"
# From OnePortal: Administration → Applications → Register application (callback URL
# http://localhost:3008/sso/callback). The secret is shown once; it is a secret: never commit
# it, never expose it as NEXT_PUBLIC_…. Lost or leaked → "Rotate secret" in the hub.
ONEPORTAL_APP_ID="<App ID from OnePortal>"
ONEPORTAL_APP_SECRET="<App secret from OnePortal>"

# --- Reverse proxy ------------------------------------------------------------------------
# Header your reverse proxy (IIS ARR, nginx…) sets with the client's IP. Leave empty if there
# is no proxy. Only recorded with sessions. Never set this when clients can reach the app
# directly: they could then write any IP into the header.
# CLIENT_IP_HEADER="x-forwarded-for"

# --- Uploaded documents --------------------------------------------------------------------
# Folder for the documents enterprises upload with imports and exports. Outside the web root;
# files are served only through the signed-in download route. Relative to the project folder
# unless absolute (e.g. D:\DigiDocsData\uploads). Back it up together with the database.
# UPLOADS_DIR="uploads"
