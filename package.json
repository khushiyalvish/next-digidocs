{
  "name": "digidocs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev",
    "build": "next build",
    "start": "dotenv -e .env.local -- next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "admin:grant": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/grant-admin.ts",
    "test-users:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-test-users.ts",
    "data:clear": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/clear-data.ts",
    "test:ui": "playwright test",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:reload": "npm run build && pm2 reload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs digidocs",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "mssql": "^12.7.4",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
