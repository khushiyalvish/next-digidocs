{
  // Press F5 to start the default configuration ("Next.js: dev server").
  // Use the dropdown in the Run and Debug panel to pick another.
  // The port comes from PORT in .env.local (see .env.example); create .env.local first.
  "version": "0.2.0",
  "configurations": [
    {
      // The one F5 runs by default: starts the dev server with the Node inspector attached,
      // so breakpoints work in server components, server actions and route handlers. No
      // browser is opened: visit the URL it prints yourself.
      "name": "Next.js: dev server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--inspect"],
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev"],
      // Next is started directly here, not through the npm script, so dotenv-cli is not in the
      // chain. This loads .env.local into the debug process instead, which is what makes PORT
      // take effect.
      "envFile": "${workspaceFolder}/.env.local",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      // Server only, in a terminal, without the debugger. Same as `npm run dev`.
      "name": "Next.js: server only",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "npm run dev"
    },
    {
      // Opens Edge on a dev server you already started, with breakpoints in client components.
      "name": "Next.js: browser only",
      "type": "msedge",
      "request": "launch",
      // Hardcoded: a browser launch has no .env.local in scope. Update it if you change PORT.
      "url": "http://localhost:3008",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${webRoot}/*"
      }
    },
    {
      // Production build served locally, for anything that only shows up outside dev mode.
      // The build runs as a preLaunchTask rather than a chained command, because Windows
      // PowerShell 5.1 has no `&&`.
      "name": "Next.js: production start",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "npm run start",
      "preLaunchTask": "next: build"
    },
    {
      // Unit checks (no database), with breakpoints.
      "name": "Tests: unit",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "npm test"
    }
  ],
  "compounds": []
}
